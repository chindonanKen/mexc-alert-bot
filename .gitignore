# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment & secrets
.env
.env.local
.env.staging
*.pem
*.key
# Desk TLS (generated on droplet by scripts/desk_gen_certs.sh)
deploy/caddy/certs/*
!deploy/caddy/certs/.gitkeep

# Data / runtime (alerts contain user-specific state)
# We want the directory to exist on clone but not the actual alerts.json
data/*
!data/.gitkeep

# Staging isolation (never share with prod ./data)
data-staging/*
!data-staging/.gitkeep

# Staging process pid (local non-Docker runs)
.staging.pid
.staging.log

# IDE / editors
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Misc
*.bak
*.tmp

# desk-qa gate state (session local)
.grok/state/

