# V2 AD Desk web UI (read-only against shared SQLite volume)
FROM python:3.11-slim

WORKDIR /app

# ffmpeg: browser mic is often WebM/Opus; xAI STT needs WAV (see audio_convert.py)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY mexc_bot/ ./mexc_bot/

RUN useradd --create-home --shell /bin/bash appuser \
    && mkdir -p /app/data \
    && chown -R appuser:appuser /app
USER appuser

ENV ALERTS_FILE=/app/data/alerts.json
ENV DESK_HOST=0.0.0.0
ENV DESK_PORT=8080

# Optional build identity for GET /api/health (do not bake tokens)
ARG GIT_SHA=
ARG IMAGE_TAG=
ENV GIT_SHA=${GIT_SHA}
ENV IMAGE_TAG=${IMAGE_TAG}

EXPOSE 8080
CMD ["python", "-m", "mexc_bot.webapi"]
