# =============================================================================
# STAGING bot — isolated from production
# =============================================================================
# - Use a SECOND BotFather token (never the prod token).
# - Data lives in ./data-staging (never ./data).
# - Start: ./scripts/staging_up.sh
# - Stop:  ./scripts/staging_down.sh
# =============================================================================

TELEGRAM_BOT_TOKEN=your_staging_bot_token_here

TIMEZONE=Asia/Singapore
ALERT_TOLERANCE_PERCENT=0.0005
PRICE_POLL_INTERVAL_SECONDS=2
MEXC_API_BASE=https://api.mexc.com/api/v3
# Relative path for local runs; Docker mounts data-staging → /app/data
ALERTS_FILE=data-staging/alerts.json

# --- V3 sensors (on for staging so you can test real dumps) ---
FEATURE_FUTURES_ALERTS=true
FEATURE_MOVER_SCANNER=true

MEXC_FUTURES_API_BASE=https://contract.mexc.com/api/v1
MOVER_LOOKBACK_SECONDS=900
MOVER_THRESHOLD_PERCENT=5
MOVER_POLL_SECONDS=5
MOVER_COOLDOWN_SECONDS=45
MOVER_RECOVERY_PERCENT=3
MOVER_MARKETS=both

MOVER_ENRICH_VELOCITY=true
MOVER_ENRICH_VOLUME=true
MOVER_ENRICH_KLINES=false
MOVER_HEAT_AUTO=true
MOVER_HEAT_BREADTH_MIN=3
MOVER_HEAT_TOP_N=5
MOVER_HEAT_MIN_GAP_SECONDS=45
MOVER_HEAT_REFRESH_SECONDS=90
MOVER_HEAT_ON_MW=true

# --- V4 assistant (ON in staging) ---
FEATURE_LEARNING=true
LEARNING_OUTCOME_HORIZONS_SECONDS=900,3600,14400
LEARNING_OUTCOME_POLL_SECONDS=60

# Fatal news — enable on staging when ready to test pushes
FEATURE_NEWS_MONITOR=true
NEWS_POLL_SECONDS=90
NEWS_PUSH_UNCONFIRMED=false

# Voice — needs Whisper-compatible API key on server
FEATURE_VOICE=false
# VOICE_STT_API_KEY=

# MEXC read-only fills (optional on staging)
FEATURE_MEXC_PRIVATE_READ=false
# MEXC_API_KEY=
# MEXC_API_SECRET=
# MEXC_PRIVATE_TELEGRAM_USER_ID=
# MEXC_FILL_NOTIFY=false

LOG_LEVEL=INFO
