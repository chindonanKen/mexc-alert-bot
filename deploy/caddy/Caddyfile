# AD Desk HTTPS front — mic needs secure context (https://).
# Certs are openssl self-signed with IP SAN (generated by scripts/desk_gen_certs.sh).
# Do NOT use tls internal here — bare droplet IPs + Caddy internal CA often fail in browsers.

{
	auto_https off
	admin off
}

:443 {
	tls /certs/desk.crt /certs/desk.key

	encode gzip

	request_body {
		max_size 25MB
	}

	# Machine is host-only on 127.0.0.1:8787 (not on the public internet).
	# Caddy uses host network so these loopback proxies work.
	handle /machine* {
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up Host {host}
		}
	}

	handle /api/machine* {
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up Host {host}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up Host {host}
		}
	}

	header {
		# No HSTS — beta dual-entry: http://IP:8080 still usable for text/UI
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "microphone=(self), camera=()"
		Cache-Control "no-store"
	}

	log {
		output stdout
		format console
	}
}
