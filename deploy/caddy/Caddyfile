# AD Desk HTTPS front door — browser mic requires secure context (https://).
# Self-signed / internal CA is fine for private beta (one-time browser warning).

{
	# Issue local certs without needing a public domain
	local_certs
	auto_https disable_redirects
}

# Full desk (mic + UI + API). Open: https://DROPLET_IP/?token=...
:443 {
	tls internal

	encode gzip

	# Short voice clips are small; leave headroom for longer takes
	request_body {
		max_size 25MB
	}

	reverse_proxy mexc-desk:8080 {
		# Preserve client IP for logs; app is token-authed
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "microphone=(self), camera=()"
		# Discourage caching of SPA shell so deploys show new JS
		Cache-Control "no-store"
	}

	log {
		output stdout
		format console
	}
}

# Never leave people on plain HTTP (mic would stay blocked)
:80 {
	redir https://{host}{uri} permanent
}
