# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: timezone for logs / future scheduling (IANA name)
TIMEZONE=Asia/Singapore

# Price tolerance: alert fires when |current - target| / target <= TOLERANCE
# 0.0005 = 0.05%  (good balance for most coins)
ALERT_TOLERANCE_PERCENT=0.0005

# Polling interval in seconds.
# With batch fetching we can safely go to 1s for timely alerts.
# Lower = more responsive (recommended for fast movers), higher = fewer API calls.
PRICE_POLL_INTERVAL_SECONDS=1

# MEXC Spot API base (public, no key needed for ticker/price)
MEXC_API_BASE=https://api.mexc.com/api/v3

# Path to alerts storage (JSON path auto-migrates to .db)
ALERTS_FILE=data/alerts.json

# ---------------------------------------------------------------------------
# V3 feature flags — DEFAULT OFF so production V1 spot alerts stay unchanged.
# Enable only on a staging/test bot first, then promote carefully.
# ---------------------------------------------------------------------------

# Futures one-shot target alerts (/af, futures book in monitor)
FEATURE_FUTURES_ALERTS=false

# Downside % mover scanner (/movers, /mw) — separate subsystem
FEATURE_MOVER_SCANNER=false

# MEXC Futures/contract public API base
MEXC_FUTURES_API_BASE=https://contract.mexc.com/api/v1

# Mover scanner defaults (users can override % and minutes via /movers set)
MOVER_LOOKBACK_SECONDS=900
MOVER_THRESHOLD_PERCENT=5
# How often to evaluate rolling high→now (seconds). Floor 2 in code. Use 3–5 for snappy.
MOVER_POLL_SECONDS=5
# Min seconds between fires for same coin (anti-spam only). Cascade uses step-down
# from last fire price — this is NOT a long mute. Old default 1800 blocked leg-2 dumps.
MOVER_COOLDOWN_SECONDS=45
# Bounce this % above last-fire price clears cascade anchor (back to peak-within-window)
MOVER_RECOVERY_PERCENT=3
# Idle fallback when no watchlist markets yet: futures | spot | both
# Live scans follow each watchlist row's market (spot and futures can mix).
MOVER_MARKETS=both

# --- Mover enrichments (scanner-owned; never touch target alerts) ---
# Velocity / PANIC|FAST|GRIND band on each fire
MOVER_ENRICH_VELOCITY=true
MOVER_VELOCITY_PANIC=2.0
MOVER_VELOCITY_FAST=0.8
# Volume line on fire (futures batch when available)
MOVER_ENRICH_VOLUME=true
# Red-candle streaks via klines (5m/15m/1h/4h). Keep false until staging OK.
MOVER_ENRICH_KLINES=false
# Auto PANIC BOARD push when many watchlist names dump (no /mw needed)
MOVER_HEAT_AUTO=true
MOVER_HEAT_BREADTH_MIN=3
# Optional absolute % for "dumping"; empty = 60% of your /movers threshold
# MOVER_HEAT_BREADTH_PCT=
MOVER_HEAT_TOP_N=5
MOVER_HEAT_MIN_GAP_SECONDS=45
MOVER_HEAT_REFRESH_SECONDS=90
# Also show heat ranking on /mw
MOVER_HEAT_ON_MW=true

# ---------------------------------------------------------------------------
# V4 learning / coach — DEFAULT OFF. See docs/V4_TRADING_ASSISTANT.md
# Logs mover fires, labels (/j), outcomes, journal (/trade), /brief /coach
# Never deletes target alerts. Enable on staging first.
# ---------------------------------------------------------------------------
FEATURE_LEARNING=false
# Bounce/DD measurement horizons after each logged fire (seconds)
LEARNING_OUTCOME_HORIZONS_SECONDS=900,3600,14400
LEARNING_OUTCOME_POLL_SECONDS=60
# AD Desk auto engagement (journal/fills → took|skip); pending Qs on desk only
LEARNING_AUTO_FROM_POSITIONS=true
LEARNING_GRACE_SECONDS=3600
LEARNING_MAX_PENDING_QUESTIONS=2
LEARNING_ENGAGEMENT_POLL_SECONDS=60
# Only use trades on/after this date for agent training (desk-era fills).
# Leave set so pre-desk history is display-only, not teach_ok.
LEARNING_TEACH_SINCE=2026-07-01

# Fatal news (delist/hack/closure/scam) — default OFF
FEATURE_NEWS_MONITOR=false
NEWS_POLL_SECONDS=90
NEWS_PUSH_UNCONFIRMED=false

# Voice notes → STT (needs VOICE_STT_API_KEY) — default OFF
FEATURE_VOICE=false
# VOICE_STT_API_KEY=
# VOICE_STT_API_BASE=https://api.openai.com/v1

# MEXC read-only fills → journal (NEVER enable trade permissions on the key)
FEATURE_MEXC_PRIVATE_READ=false
# MEXC_API_KEY=
# MEXC_API_SECRET=
# MEXC_PRIVATE_TELEGRAM_USER_ID=   # your Telegram user id (numeric)
# MEXC_FILL_SYNC_POLL_SECONDS=120
# MEXC_FILL_NOTIFY=false

# Isolated dump specialist (async after extreme isolated movers — never delays fires)
FEATURE_ISOLATED_DUMP_AGENT=false
ISOLATED_MIN_DROP_PCT=8
ISOLATED_THRESHOLD_MULTIPLIER=1.6
ISOLATED_MAX_HEAT_BREADTH=2
ISOLATED_REQUIRE_FAST_OR_PANIC=true
ISOLATED_COOLDOWN_SECONDS=900
ISOLATED_NOTIFY_NONE=true
# Cause→effect learning horizon (seconds). 14400 = 4 hours.
ISOLATED_OUTCOME_HORIZON_SECONDS=14400
DELIST_RADAR_POLL_SECONDS=180

# V2 AD Desk web UI (python -m mexc_bot.webapi / docker profile desk)
# DESK_API_TOKEN=change-me-long-random
# DESK_USER_ID=8630949601       # owner Telegram/desk user id (multi-user DBs / CRUD)
# DESK_PORT=8080
# DESK_HOST=0.0.0.0
# XAI_API_KEY=                  # Grok Voice STT + tool agent + optional TTS
# XAI_API_BASE=https://api.x.ai/v1
# XAI_CHAT_MODEL=grok-4.5
# DESK_VOICE_TTS=true
# XAI_TTS_VOICE_ID=eve          # xAI built-in: eve, ara, leo, …
# XAI_TTS_LANGUAGE=en
# DESK_ALLOW_LIVE_ORDERS=false  # keep false — no exchange order placement in desk

# Optional: DEBUG for per-alert decision logs
# LOG_LEVEL=INFO
