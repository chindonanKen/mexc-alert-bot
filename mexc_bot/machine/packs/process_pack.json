{
  "version": 3,
  "name": "ad-process",
  "rules": [
    {
      "id": "fail.news",
      "family": "fail",
      "priority": 0,
      "when": ["news_kill"],
      "action": "flatten-news",
      "why": "Real bad news, flatten."
    },
    {
      "id": "plan.none",
      "family": "plan",
      "priority": 1,
      "when": ["not_written_plan"],
      "action": "sit-out",
      "why": "No written plan, sit."
    },
    {
      "id": "exit.no_rebuy",
      "family": "exit",
      "priority": 2,
      "when": ["written_plan", "sold_bounce"],
      "action": "wait",
      "why": "Bounce already sold, not buying the quiet walk."
    },
    {
      "id": "exit.into_base",
      "family": "exit",
      "priority": 2,
      "when": ["live", "into_base", "not_killed"],
      "action": "paper-sell",
      "why": "Last travelled into a hung big base, selling the invested bag."
    },
    {
      "id": "exit.stale_ad",
      "family": "exit",
      "priority": 2,
      "when": ["live", "at_ad", "candles_stale", "not_killed"],
      "action": "paper-sell",
      "why": "This TF's usual candles-to-start passed at the AD with no bounce like this chart prints, considering out."
    },
    {
      "id": "exit.panic_up",
      "family": "exit",
      "priority": 2,
      "when": ["live", "panic_up_volume", "not_sold_bounce", "not_killed"],
      "action": "paper-sell",
      "why": "Panic-like dollar volume on the way up, selling a matching amount."
    },
    {
      "id": "exit.bounce_strong",
      "family": "exit",
      "priority": 2,
      "when": ["live", "bounce_strong", "not_sold_bounce", "not_killed", "not_board_panic"],
      "action": "paper-sell",
      "why": "First bounce already strong versus this TF's usual run, selling a matching amount."
    },
    {
      "id": "atad.take",
      "family": "at-ad",
      "priority": 2,
      "when": ["written_plan", "at_ad", "not_killed", "not_sold_bounce", "not_should_sell"],
      "action": "paper-buy",
      "why": "Plan written and last at this chart's AD, taking the at-AD layer."
    },
    {
      "id": "path.sit_reds",
      "family": "path",
      "priority": 4,
      "when": ["written_plan", "not_at_ad", "not_live", "first_or_second_red", "not_board_panic", "not_fast_dump_volume"],
      "action": "sit-out",
      "why": "First or second red on this TF, sit out on a normal dump."
    },
    {
      "id": "fail.add_panic",
      "family": "fail",
      "priority": 6,
      "when": ["written_plan", "past_panic", "fast_dump_volume", "not_news_kill", "not_killed"],
      "action": "add-panic",
      "why": "Break of AD, add with the panic half."
    },
    {
      "id": "fail.lower_pack",
      "family": "fail",
      "priority": 6,
      "when": ["live", "past_b", "not_past_panic", "not_board_panic", "not_fast_dump_volume", "not_killed"],
      "action": "pull-pack",
      "why": "Drop past AD that is not board-wide panic, lowering the pack from the new bottom."
    },
    {
      "id": "exit.weak_pull",
      "family": "exit",
      "priority": 5,
      "when": ["live", "bounce_weak", "not_should_sell", "not_sold_bounce", "not_killed"],
      "action": "pull-pack",
      "why": "Weak bounce, pulling remaining pack down."
    },
    {
      "id": "size.quiet_grind",
      "family": "size",
      "priority": 5,
      "when": ["written_plan", "not_killed", "not_at_ad", "quiet_grind", "not_board_grind", "not_past_b"],
      "action": "wait",
      "why": "Quiet grind, no dollar volume spike, wait."
    },
    {
      "id": "size.nibble",
      "family": "grind",
      "priority": 5,
      "when": ["written_plan", "not_live", "board_grind", "not_at_ad", "approaching_ad", "not_nibble_done", "not_sold_bounce", "not_killed", "not_past_b"],
      "action": "paper-buy",
      "why": "Board-wide grind registered, nibble 10 percent of the play on a quiet approach."
    },
    {
      "id": "size.fast_dump",
      "family": "size",
      "priority": 5,
      "when": ["written_plan", "fast_dump_volume", "not_sold_bounce", "not_killed", "not_past_panic"],
      "action": "paper-buy",
      "why": "Fast dump with dollar volume, taking from the first real-volume layer."
    },
    {
      "id": "size.wait",
      "family": "size",
      "priority": 5,
      "when": ["written_plan", "not_killed", "not_at_ad", "not_past_b", "not_board_grind", "not_bounce_weak"],
      "action": "wait",
      "why": "Plan written, last not at the AD, wait."
    }
  ]
}
